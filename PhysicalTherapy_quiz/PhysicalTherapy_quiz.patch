diff --git a/PhysicalTherapy/css/style.css b/PhysicalTherapy/css/style.css
new file mode 100644
--- /dev/null
+++ b/PhysicalTherapy/css/style.css
@@ -0,0 +1,307 @@
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+body {
+  font-family: "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
+  font-size: 16px;
+  background: #f5f7fa;
+  color: #333;
+  line-height: 1.6;
+}
+
+.container {
+  max-width: 720px;
+  margin: 0 auto;
+  padding: 20px 16px;
+}
+
+.header {
+  background: #1a5276;
+  color: #fff;
+  padding: 16px 20px;
+  text-align: center;
+}
+
+.header h1 {
+  font-size: 18px;
+  font-weight: bold;
+}
+
+.header p {
+  font-size: 13px;
+  opacity: 0.85;
+  margin-top: 4px;
+}
+
+.card {
+  background: #fff;
+  border-radius: 8px;
+  padding: 24px;
+  margin-top: 20px;
+  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
+}
+
+.intro-text {
+  margin-bottom: 16px;
+  font-size: 14px;
+  color: #555;
+}
+
+.student-id-section label {
+  display: block;
+  font-weight: bold;
+  margin-bottom: 8px;
+}
+
+.student-id-section input {
+  width: 100%;
+  padding: 10px 12px;
+  font-size: 16px;
+  border: 2px solid #ccc;
+  border-radius: 6px;
+  outline: none;
+}
+
+.student-id-section input:focus {
+  border-color: #1a5276;
+}
+
+.progress-bar-wrap {
+  background: #e0e0e0;
+  border-radius: 4px;
+  height: 8px;
+  margin-bottom: 16px;
+}
+
+.progress-bar {
+  background: #1a5276;
+  height: 8px;
+  border-radius: 4px;
+  transition: width 0.3s ease;
+}
+
+.progress-text {
+  font-size: 13px;
+  color: #666;
+  margin-bottom: 8px;
+  text-align: right;
+}
+
+.question-text {
+  font-size: 17px;
+  font-weight: bold;
+  margin-bottom: 20px;
+  line-height: 1.7;
+}
+
+.options-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.option-btn {
+  width: 100%;
+  text-align: left;
+  padding: 14px 16px;
+  font-size: 15px;
+  border: 2px solid #ccc;
+  border-radius: 8px;
+  background: #fff;
+  cursor: pointer;
+  transition: border-color 0.15s, background 0.15s;
+  line-height: 1.5;
+}
+
+.option-btn:hover:not(:disabled) {
+  border-color: #1a5276;
+  background: #eaf0f8;
+}
+
+.option-btn.correct {
+  border-color: #27ae60;
+  background: #eafaf1;
+  color: #1e8449;
+  font-weight: bold;
+}
+
+.option-btn.incorrect {
+  border-color: #e74c3c;
+  background: #fdf2f2;
+  color: #c0392b;
+}
+
+.option-btn:disabled {
+  cursor: default;
+}
+
+.feedback-box {
+  margin-top: 16px;
+  padding: 12px 16px;
+  border-radius: 6px;
+  font-size: 14px;
+  line-height: 1.6;
+  display: none;
+}
+
+.feedback-box.correct {
+  background: #eafaf1;
+  border-left: 4px solid #27ae60;
+  color: #1e8449;
+}
+
+.feedback-box.incorrect {
+  background: #fdf2f2;
+  border-left: 4px solid #e74c3c;
+  color: #922b21;
+}
+
+.feedback-box .explanation {
+  color: #555;
+  margin-top: 6px;
+}
+
+.btn {
+  display: block;
+  width: 100%;
+  padding: 14px;
+  font-size: 16px;
+  font-weight: bold;
+  border: none;
+  border-radius: 8px;
+  cursor: pointer;
+  margin-top: 20px;
+  transition: opacity 0.15s;
+}
+
+.btn:hover {
+  opacity: 0.9;
+}
+
+.btn-primary {
+  background: #1a5276;
+  color: #fff;
+}
+
+.result-heading {
+  text-align: center;
+  font-size: 18px;
+  margin-bottom: 12px;
+}
+
+.result-score {
+  font-size: 48px;
+  font-weight: bold;
+  text-align: center;
+  color: #1a5276;
+  margin: 16px 0 8px;
+}
+
+.result-label {
+  text-align: center;
+  font-size: 14px;
+  color: #666;
+  margin-bottom: 20px;
+}
+
+.result-message {
+  text-align: center;
+  font-size: 18px;
+  font-weight: bold;
+  margin-bottom: 20px;
+}
+
+.result-list {
+  list-style: none;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-bottom: 20px;
+}
+
+.result-item {
+  padding: 10px 14px;
+  border-radius: 6px;
+  font-size: 14px;
+}
+
+.result-item.ok {
+  background: #eafaf1;
+  border-left: 4px solid #27ae60;
+}
+
+.result-item.ng {
+  background: #fdf2f2;
+  border-left: 4px solid #e74c3c;
+}
+
+.submit-status {
+  text-align: center;
+  font-size: 14px;
+  margin-top: 12px;
+  min-height: 20px;
+}
+
+.submit-status.sending { color: #888; }
+.submit-status.success { color: #27ae60; font-weight: bold; }
+.submit-status.error   { color: #e74c3c; }
+
+.quiz-list {
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  margin-top: 8px;
+}
+
+.quiz-card {
+  display: block;
+  padding: 18px 20px;
+  background: #fff;
+  border: 2px solid #dde3ec;
+  border-radius: 8px;
+  text-decoration: none;
+  color: #333;
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+
+.quiz-card:hover {
+  border-color: #1a5276;
+  box-shadow: 0 2px 10px rgba(26,82,118,0.12);
+}
+
+.quiz-card .quiz-num {
+  font-size: 12px;
+  color: #888;
+  margin-bottom: 4px;
+}
+
+.quiz-card .quiz-title {
+  font-size: 16px;
+  font-weight: bold;
+}
+
+.quiz-card .quiz-meta {
+  font-size: 13px;
+  color: #777;
+  margin-top: 4px;
+}
+
+.return-link {
+  text-align: center;
+  text-decoration: none;
+}
+
+.loading {
+  text-align: center;
+  padding: 40px;
+  color: #888;
+}
+
+.error-text {
+  color: #e74c3c;
+  font-weight: bold;
+}
